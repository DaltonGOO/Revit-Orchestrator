<Window x:Class="RevitOrchestrator.UI.MappingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Type Mismatch"
        Width="500" Height="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   FontSize="16" FontWeight="Bold"
                   x:Name="HeaderText"
                   Text="Type Mismatch — System Type"
                   Margin="0,0,0,8"/>

        <!-- Recorded value -->
        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock FontWeight="SemiBold" Text="Recorded Value:"/>
            <TextBlock x:Name="RecordedValueText"
                       FontFamily="Consolas"
                       Foreground="#CC6600"
                       Margin="8,2,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Instruction -->
        <TextBlock Grid.Row="2"
                   Text="Select a replacement from the available options:"
                   Margin="0,0,0,4"/>

        <!-- Available options list -->
        <ListBox Grid.Row="3"
                 x:Name="OptionsListBox"
                 Margin="0,0,0,8"
                 FontFamily="Consolas"
                 FontSize="12">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayText}" Margin="4,2"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Buttons -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0">
            <Button Content="Cancel"
                    Width="100" Height="30"
                    Margin="0,0,8,0"
                    Click="OnCancel"/>
            <Button Content="Use Selected"
                    Width="120" Height="30"
                    IsDefault="True"
                    Click="OnUseSelected"
                    Background="#4CAF50"
                    Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
