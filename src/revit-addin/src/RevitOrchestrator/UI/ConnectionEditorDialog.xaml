<Window x:Class="RevitOrchestrator.UI.ConnectionEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MCP Connection"
        Width="480"
        Height="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Preset -->
                <TextBlock Text="Preset"
                           FontWeight="Bold" FontSize="14"
                           Foreground="#1a73e8" Margin="0,0,0,8" />
                <ComboBox x:Name="PresetComboBox" Margin="0,0,0,4"
                          SelectionChanged="PresetComboBox_SelectionChanged">
                    <ComboBoxItem Tag="custom" Content="Custom (configure manually)" IsSelected="True" />
                    <ComboBoxItem Tag="filesystem" Content="Filesystem — read/write files in a folder" />
                    <ComboBoxItem Tag="fetch" Content="Fetch — fetch HTTP URLs" />
                    <ComboBoxItem Tag="memory" Content="Memory — scratch key/value store" />
                    <ComboBoxItem Tag="time" Content="Time — date/time and timezones" />
                    <ComboBoxItem Tag="everything" Content="Everything — MCP test server (smoke test)" />
                </ComboBox>
                <TextBlock x:Name="PresetHintText"
                           Text="Pick a preset to auto-fill the fields below, or choose Custom to configure manually."
                           Foreground="#666" FontSize="11"
                           TextWrapping="Wrap" Margin="0,0,0,16" />

                <!-- Filesystem folder picker (only visible for Filesystem preset) -->
                <StackPanel x:Name="FolderPickerPanel" Visibility="Collapsed" Margin="0,0,0,12">
                    <TextBlock Text="Allowed Folder"
                               FontWeight="Bold" FontSize="14"
                               Foreground="#1a73e8" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="FolderPathTextBox" Padding="6,4"
                                 ToolTip="The folder the server is allowed to read/write."
                                 TextChanged="FolderPathTextBox_TextChanged" />
                        <Button Grid.Column="1" Content="Browse…" Padding="12,4" Margin="6,0,0,0"
                                Click="BrowseFolderButton_Click" />
                    </Grid>
                    <TextBlock Text="The server can only access files inside this folder. Pick a narrow path — never the root of your drive."
                               Foreground="#666" FontSize="11"
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>

                <Separator Margin="0,0,0,12" />

                <!-- Name -->
                <TextBlock Text="Connection Name"
                           FontWeight="Bold" FontSize="14"
                           Foreground="#1a73e8" Margin="0,0,0,8" />
                <TextBox x:Name="NameTextBox" Margin="0,0,0,16" Padding="6,4"
                         ToolTip="Alphanumeric and underscores only (e.g. my_excel_server)" />

                <Separator Margin="0,0,0,12" />

                <!-- Transport -->
                <TextBlock Text="Transport"
                           FontWeight="Bold" FontSize="14"
                           Foreground="#1a73e8" Margin="0,0,0,8" />
                <ComboBox x:Name="TransportComboBox" Margin="0,0,0,16"
                          SelectionChanged="TransportComboBox_SelectionChanged">
                    <ComboBoxItem Tag="stdio" Content="STDIO (local process)" IsSelected="True" />
                    <ComboBoxItem Tag="sse" Content="SSE (Server-Sent Events)" />
                    <ComboBoxItem Tag="streamable_http" Content="Streamable HTTP" />
                </ComboBox>

                <!-- STDIO fields -->
                <StackPanel x:Name="StdioPanel">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Command:" Foreground="#666"
                                   VerticalAlignment="Center" Margin="0,4" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="CommandTextBox" Margin="0,4" Padding="4,4"
                                 ToolTip="Path to executable (e.g. npx, python, node)" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Arguments:" Foreground="#666"
                                   VerticalAlignment="Center" Margin="0,4" />
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="ArgsTextBox" Margin="0,4" Padding="4,4"
                                 ToolTip="Space-separated arguments" />
                    </Grid>
                </StackPanel>

                <!-- URL fields (SSE / HTTP) -->
                <StackPanel x:Name="UrlPanel" Visibility="Collapsed">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="URL:" Foreground="#666"
                                   VerticalAlignment="Center" Margin="0,4" />
                        <TextBox Grid.Column="1" x:Name="UrlTextBox" Margin="0,4" Padding="4,4"
                                 ToolTip="Full URL to the MCP server endpoint" />
                    </Grid>
                </StackPanel>

                <Separator Margin="0,4,0,12" />

                <!-- Authentication -->
                <TextBlock Text="Authentication"
                           FontWeight="Bold" FontSize="14"
                           Foreground="#1a73e8" Margin="0,0,0,8" />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Auth Type:" Foreground="#666"
                               VerticalAlignment="Center" Margin="0,4" />
                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="AuthTypeComboBox" Margin="0,4"
                              SelectionChanged="AuthTypeComboBox_SelectionChanged">
                        <ComboBoxItem Tag="none" Content="None" IsSelected="True" />
                        <ComboBoxItem Tag="api_key" Content="API Key (X-API-Key header)" />
                        <ComboBoxItem Tag="bearer" Content="Bearer Token" />
                        <ComboBoxItem Tag="custom_header" Content="Custom Header" />
                    </ComboBox>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Credential:" Foreground="#666"
                               VerticalAlignment="Center" Margin="0,4"
                               x:Name="CredentialLabel" Visibility="Collapsed" />
                    <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="CredentialBox" Margin="0,4"
                                 Visibility="Collapsed"
                                 ToolTip="For custom_header, format as 'Header-Name: value'" />
                </Grid>

                <!-- Enable on save -->
                <CheckBox x:Name="EnabledCheckBox" Content="Enable connection (auto-connect)"
                          IsChecked="True" Margin="0,8,0,0" />

            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Padding="24,8" Margin="0,0,8,0"
                    Click="CancelButton_Click" />
            <Button Content="Save" Padding="24,8"
                    Background="#1a73e8" Foreground="White"
                    FontWeight="SemiBold" BorderThickness="0"
                    Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
