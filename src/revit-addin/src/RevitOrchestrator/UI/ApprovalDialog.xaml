<Window x:Class="RevitOrchestrator.UI.ApprovalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Approve Tool Execution"
        Width="450" Height="350"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   FontSize="16" FontWeight="Bold"
                   Text="Tool Execution Approval Required"
                   Margin="0,0,0,12"/>

        <!-- Tool name -->
        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock FontWeight="SemiBold" Text="Tool:"/>
            <TextBlock x:Name="ToolNameText" 
                       Text="revit.create_wall" 
                       FontFamily="Consolas"
                       Margin="8,2,0,0"/>
        </StackPanel>

        <!-- Side effects -->
        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock FontWeight="SemiBold" Text="Side Effects:"/>
            <ItemsControl x:Name="SideEffectsList" Margin="8,2,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="#CC6600"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Arguments summary -->
        <StackPanel Grid.Row="3" Margin="0,0,0,8">
            <TextBlock FontWeight="SemiBold" Text="Arguments:"/>
            <TextBox x:Name="ArgsText"
                     IsReadOnly="True"
                     FontFamily="Consolas"
                     FontSize="11"
                     VerticalScrollBarVisibility="Auto"
                     TextWrapping="Wrap"
                     Margin="8,2,0,0"
                     MaxHeight="120"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0">
            <Button Content="Deny" 
                    Width="100" Height="30"
                    Margin="0,0,8,0"
                    Click="OnDeny"/>
            <Button Content="Approve" 
                    Width="100" Height="30"
                    IsDefault="True"
                    Click="OnApprove"
                    Background="#4CAF50"
                    Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
