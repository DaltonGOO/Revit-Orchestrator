{
  "name": "orchestrator.query_history",
  "adapter": "workflow",
  "description": "Queries the execution history from the audit log. Returns summaries of past tool executions.",
  "version": "1.0.0",
  "tags": ["observability", "history", "audit"],
  "permissions": {
    "mode": "read"
  },
  "side_effects": [],
  "parameters": {
    "type": "object",
    "properties": {
      "date": {
        "type": "string",
        "description": "Date to query in YYYY-MM-DD format (default: today)"
      },
      "tool_name": {
        "type": "string",
        "description": "Filter by tool name"
      },
      "correlation_id": {
        "type": "string",
        "description": "Filter by correlation ID"
      },
      "limit": {
        "type": "integer",
        "description": "Maximum number of events to return (default: 20)",
        "default": 20
      }
    }
  },
  "returns": {
    "type": "object",
    "properties": {
      "events": {
        "type": "array",
        "description": "Matching execution events"
      },
      "total_count": { "type": "integer" }
    }
  },
  "examples": [
    {
      "description": "Get recent execution history",
      "args": { "limit": 10 }
    },
    {
      "description": "Query specific tool history",
      "args": { "tool_name": "revit.create_wall", "limit": 5 }
    }
  ]
}
